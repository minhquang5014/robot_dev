# Duong dan tuyet doi cua tung may, khong mang sang may khac duoc
.vscode/

# ---- Khoa API: luoi an toan ----
# ver1 da co quy tac rieng. Dat lai o day vi ban sao sang ver2 rat de bi quen
# chep theo .gitignore — ma quen mot lan la khoa len GitHub vinh vien.
**/.env

# Firmware phuc vu OTA: 2,5MB moi ban, chep vao ngay truoc khi deploy
**/server/firmware/*.bin

# ---- San pham build ----
**/build/
**/managed_components/
**/dependencies.lock
**/sdkconfig.old
*.elf
*.map

# ---- Linh tinh ----
.DS_Store
*.pyc
__pycache__/
.venv/
