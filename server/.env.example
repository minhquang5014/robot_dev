# Copy file nay thanh .env roi dien key that vao.
# Lay key mien phi tai https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Giong doc EdgeTTS. Hai giong tieng Viet co san:
#   vi-VN-HoaiMyNeural  (nu)
#   vi-VN-NamMinhNeural (nam)
TTS_VOICE=vi-VN-HoaiMyNeural

# Noi nhanh hon mot chut nghe tre trung hon, hop robot cute.
TTS_RATE=+10%
TTS_PITCH=+15Hz

STT_MODEL=whisper-large-v3-turbo

# Groq da GO BO llama-3.1-8b-instant. Do ngay 17/09/2026, trung vi 10 luot:
#   qwen/qwen3.8-27b      362ms   <- dang dung. Nhanh nhat, bien do hep nhat
#   openai/gpt-oss-120b   547ms   <- ton token suy nghi vao han muc
#   openai/gpt-oss-20b    677ms   <- hay chen tag [..] thua giua cau
#   groq/compound-mini   1369ms
#   allam-2-7b            419ms   <- nho nhat nhung KHONG nhanh hon, tieng Viet hong
# (Hom 16/09 cung qwen do 762ms — free tier dao dong theo ngay.)
# Chay `python server/test_voice.py --models` de xem danh sach hien tai.
LLM_MODEL=qwen/qwen3.8-27b

# Chi co tac dung voi ho gpt-oss: low / medium / high.
# Model mac dinh (qwen) khong phai model reasoning nen dong nay bi bo qua.
REASONING_EFFORT=low
